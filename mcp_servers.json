{
  "servers": {
    "data_fetch_mcp_http": {
      "enabled": true,
      "transport": "streamable-http",
      "url": "http://localhost:8050/mcp",
      "headers": {
        "Authorization": "Bearer your-token"
      }
    },
    "data_fetch_mcp_stdio_backup": {
      "enabled": false,
      "transport": "stdio",
      "command": "{venv_python}",
      "args": [
        "{project_root}/CH-1_CreateMCP/1_first_mcpserver_stdio.py"
      ]
    }
  }
}
